// bookshelf/ui.jsx — design tokens + shared components for My Bookshelf.
const { useState, useEffect, useRef } = React;

// ── Tokens (injected once) ───────────────────────────────────────────
const BS_TOKENS = `
:root {
  --forest:#2f4a36; --moss:#4d6b50; --sage:#86a083;
  --cream:#f1e8d6; --paper:#fbf6ea; --card:#fffdf7;
  --terra:#c25a3a; --terra-deep:#a8472b; --clay:#d98e6a;
  --gold:#d8a441; --ink:#2b2a26; --muted:#7d7763;
  --line:rgba(47,74,54,0.12); --line-soft:rgba(47,74,54,0.07);
}
.bs { font-family:'Hanken Grotesk',system-ui,sans-serif; color:var(--ink); -webkit-font-smoothing:antialiased; }
.bs-serif { font-family:'DM Serif Display',Georgia,serif; }
.bs-screen { position:absolute; inset:0; display:flex; flex-direction:column; background:var(--paper); }
.bs-scroll { flex:1; overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch; }
.bs-scroll::-webkit-scrollbar{ display:none; }
.bs-fade-in { animation:bsFade .32s ease; }
@keyframes bsFade { from{transform:translateY(6px);} to{transform:none;} }
@media (prefers-reduced-motion: reduce) { .bs-fade-in { animation:none; } }
.bs-press { transition:transform .12s ease, filter .12s ease; cursor:pointer; -webkit-tap-highlight-color:transparent; }
.bs-press:active { transform:scale(0.97); filter:brightness(0.97); }
`;

function useBsTokens() {
  useEffect(() => {
    if (document.getElementById('bs-tokens')) return;
    const s = document.createElement('style'); s.id = 'bs-tokens';
    s.textContent = BS_TOKENS; document.head.appendChild(s);
  }, []);
}

// ── The shelf logo mark (matches the finalized logo) ─────────────────
function ShelfMark({ size = 28, ember = true }) {
  const c = ember
    ? { c1: '#c25a3a', c2: '#d8a441', c3: '#d98e6a' }
    : { c1: '#fffdf7', c2: '#fffdf7', c3: '#fffdf7' };
  return (
    <svg width={size} height={size} viewBox="0 0 100 100" aria-label="My Bookshelf">
      <rect x="15" y="24" width="11" height="50" rx="3.2" fill={c.c1}/>
      <rect x="28" y="32" width="11" height="42" rx="3.2" fill={c.c3}/>
      <rect x="41" y="20" width="11" height="54" rx="3.2" fill={c.c2}/>
      <g transform="rotate(11 60 50)"><rect x="55" y="28" width="11" height="46" rx="3.2" fill={c.c1}/></g>
      <rect x="70" y="30" width="11" height="44" rx="3.2" fill={c.c3}/>
      <rect x="12" y="76" width="74" height="7" rx="3.5" fill={c.c1}/>
    </svg>
  );
}

// ── Stars ────────────────────────────────────────────────────────────
function Stars({ value = 0, size = 14, gap = 2, color = 'var(--gold)', empty = 'rgba(47,74,54,0.18)' }) {
  return (
    <div style={{ display: 'inline-flex', gap }}>
      {[1,2,3,4,5].map(i => (
        <svg key={i} width={size} height={size} viewBox="0 0 24 24" style={{ flex: 'none' }}>
          <path d="M12 2.6l2.7 5.9 6.4.7-4.8 4.3 1.3 6.3L12 17l-5.6 2.8 1.3-6.3-4.8-4.3 6.4-.7z"
            fill={i <= Math.round(value) ? color : empty}/>
        </svg>
      ))}
    </div>
  );
}

function StarPicker({ value, onChange, size = 30 }) {
  return (
    <div style={{ display: 'flex', gap: 8 }}>
      {[1,2,3,4,5].map(i => (
        <div key={i} className="bs-press" onClick={() => onChange(i)}>
          <svg width={size} height={size} viewBox="0 0 24 24">
            <path d="M12 2.6l2.7 5.9 6.4.7-4.8 4.3 1.3 6.3L12 17l-5.6 2.8 1.3-6.3-4.8-4.3 6.4-.7z"
              fill={i <= value ? 'var(--gold)' : 'transparent'} stroke="var(--gold)" strokeWidth="1.6" strokeLinejoin="round"/>
          </svg>
        </div>
      ))}
    </div>
  );
}

// ── Book cover with graceful fallback ────────────────────────────────
function Cover({ isbn, title, author, w = '100%', radius = 8, shadow = true }) {
  const [err, setErr] = useState(false);
  const ratio = 1.5; // h/w
  const bg = ['#3a5242','#6b4a3a','#4a4668','#7a5340','#42565f'][(title?.length || 3) % 5];
  return (
    <div style={{
      width: w, aspectRatio: '1 / 1.5', borderRadius: radius, overflow: 'hidden',
      position: 'relative', background: bg, flex: 'none',
      boxShadow: shadow ? '0 6px 16px rgba(43,42,38,0.22), 0 1px 0 rgba(255,255,255,0.4) inset' : 'none',
    }}>
      {!err ? (
        <img src={COVER(isbn)} alt={title} onError={() => setErr(true)}
          style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }}/>
      ) : (
        <div style={{ position: 'absolute', inset: 0, padding: '14% 12%', display: 'flex', flexDirection: 'column', color: '#fff' }}>
          <div className="bs-serif" style={{ fontSize: '1.05rem', lineHeight: 1.1, textShadow: '0 1px 2px rgba(0,0,0,.3)' }}>{title}</div>
          <div style={{ marginTop: 'auto', fontSize: '.7rem', opacity: .85, letterSpacing: .3 }}>{author}</div>
        </div>
      )}
      <div style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: 3, background: 'rgba(0,0,0,0.16)' }}/>
    </div>
  );
}

// ── Price / free tag ──────────────────────────────────────────────────
function PriceTag({ price, free, size = 'md' }) {
  const big = size === 'lg';
  if (free) return (
    <span className="bs" style={{
      fontWeight: 700, fontSize: big ? 15 : 12.5, color: 'var(--moss)',
      background: 'rgba(77,107,80,0.12)', padding: big ? '5px 12px' : '3px 9px',
      borderRadius: 999, letterSpacing: .2,
    }}>Free</span>
  );
  return (
    <span className="bs" style={{
      fontWeight: 700, fontSize: big ? 18 : 13, color: 'var(--terra)',
    }}>€{price}</span>
  );
}

function ConditionBadge({ condition }) {
  const map = { 'As New': 'var(--moss)', 'Used': 'var(--gold)', 'Quite Old': 'var(--clay)' };
  return (
    <span className="bs" style={{
      fontSize: 11, fontWeight: 600, color: 'var(--ink)', opacity: .72,
      display: 'inline-flex', alignItems: 'center', gap: 5,
    }}>
      <span style={{ width: 7, height: 7, borderRadius: 99, background: map[condition] || 'var(--sage)' }}/>
      {condition}
    </span>
  );
}

// ── Buttons ───────────────────────────────────────────────────────────
function Btn({ children, onClick, kind = 'primary', full, style = {}, icon }) {
  const base = {
    border: 'none', borderRadius: 14, fontFamily: "'Hanken Grotesk',sans-serif",
    fontWeight: 700, fontSize: 16, padding: '15px 22px', cursor: 'pointer',
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center', gap: 9,
    width: full ? '100%' : undefined, letterSpacing: .2,
  };
  const kinds = {
    primary:   { background: 'var(--terra)', color: '#fff', boxShadow: '0 8px 18px rgba(194,90,58,0.32)' },
    forest:    { background: 'var(--forest)', color: 'var(--cream)', boxShadow: '0 8px 18px rgba(47,74,54,0.28)' },
    ghost:     { background: 'transparent', color: 'var(--forest)', border: '1.5px solid var(--line)' },
    soft:      { background: 'var(--cream)', color: 'var(--forest)' },
  };
  return (
    <button className="bs bs-press" onClick={onClick} style={{ ...base, ...kinds[kind], ...style }}>
      {icon}{children}
    </button>
  );
}

// ── Section header label ──────────────────────────────────────────────
function Eyebrow({ children, style = {} }) {
  return (
    <div className="bs" style={{
      fontSize: 12, fontWeight: 700, letterSpacing: 1.4, textTransform: 'uppercase',
      color: 'var(--sage)', ...style,
    }}>{children}</div>
  );
}

// ── Top bar (app header inside frame) ────────────────────────────────
function TopBar({ title, onBack, right, dark, large }) {
  const fg = dark ? 'var(--cream)' : 'var(--forest)';
  return (
    <div className="bs" style={{
      paddingTop: 56, paddingLeft: 18, paddingRight: 18, paddingBottom: large ? 4 : 12,
      display: 'flex', alignItems: 'center', gap: 12, flex: 'none',
    }}>
      {onBack && (
        <div className="bs-press" onClick={onBack} style={{
          width: 38, height: 38, borderRadius: 12, flex: 'none',
          display: 'grid', placeItems: 'center',
          background: dark ? 'rgba(255,255,255,0.14)' : 'var(--card)',
          boxShadow: '0 2px 8px rgba(43,42,38,0.08)',
        }}>
          <svg width="11" height="18" viewBox="0 0 11 18" fill="none">
            <path d="M9 2L2 9l7 7" stroke={fg} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </div>
      )}
      {!large && <div className="bs-serif" style={{ fontSize: 21, color: fg, flex: 1 }}>{title}</div>}
      {!large && <div style={{ marginLeft: 'auto', display: 'flex', gap: 8 }}>{right}</div>}
      {large && right && <div style={{ marginLeft: 'auto', display: 'flex', gap: 8 }}>{right}</div>}
    </div>
  );
}

Object.assign(window, {
  useBsTokens, ShelfMark, Stars, StarPicker, Cover, PriceTag, ConditionBadge, Btn, Eyebrow, TopBar,
});
